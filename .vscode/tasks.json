{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Server running on port.*"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "label": "npm: dev - Jalankan PT Perintis Bermuda Perkasa"
    },
    {
      "type": "npm",
      "script": "build",
      "group": "build",
      "problemMatcher": [],
      "label": "npm: build - Kompilasi Proyek Produksi"
    },
    {
      "type": "npm",
      "script": "typecheck",
      "group": "test",
      "problemMatcher": ["$tsc"],
      "label": "npm: typecheck - Cek Validasi TypeScript"
    }
  ]
}
